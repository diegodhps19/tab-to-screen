{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.3.1",
  "default_locale": "en",
  "minimum_chrome_version": "102",
  "permissions": ["system.display", "storage"],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
